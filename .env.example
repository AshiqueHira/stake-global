# Optional: change when deploying to another approved origin.
# Local development works without creating an .env.local file.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub Pages workflow supplies these automatically.
# STATIC_EXPORT=true
# NEXT_PUBLIC_BASE_PATH=/stake-global-nextjs

# Contact form email (Resend). Server-only: never prefix with NEXT_PUBLIC_.
# Use a sending-only key from https://resend.com/api-keys
RESEND_API_KEY=
# Where inquiries are delivered. With the default onboarding@resend.dev sender
# this MUST be the email your Resend account was created with.
INQUIRY_TO_EMAIL=
# Optional. Switch to e.g. "Stake Global <inquiries@mail.yourdomain.com>" once
# a domain is verified in Resend.
# INQUIRY_FROM_EMAIL=Stake Global <onboarding@resend.dev>
