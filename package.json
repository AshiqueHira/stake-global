{
  "name": "stake-global-nextjs",
  "version": "1.0.0",
  "description": "Stake Global brand and information website — Next.js App Router",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,ts,md}\"",
    "test": "node scripts/verify-build.mjs",
    "check": "npm run build && npm run typecheck && npm test"
  },
  "type": "module",
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  }
}
